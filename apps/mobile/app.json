{
  "expo": {
    "name": "Agritha",
    "slug": "agritha",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1F4D2E"
    },
    "scheme": "agritha",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.agritha.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1F4D2E"
      },
      "package": "com.agritha.app",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1F4D2E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
