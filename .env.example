# ─────────────────────────────────────────────
# SUPABASE
# ─────────────────────────────────────────────
# Get these from: Supabase Dashboard → Settings → Data API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─────────────────────────────────────────────
# RAZORPAY (Test Mode Keys)
# ─────────────────────────────────────────────
# Get these from: Razorpay Dashboard → Settings → API Keys
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret-here

# ─────────────────────────────────────────────
# MAPS
# ─────────────────────────────────────────────
# OpenStreetMap is used — no API key needed

# ─────────────────────────────────────────────
# MSG91 (SMS OTP — leave empty for dev, uses Supabase test OTP)
# ─────────────────────────────────────────────
MSG91_AUTH_KEY=
MSG91_SENDER_ID=AGRTHA

# ─────────────────────────────────────────────
# ADMIN DASHBOARD (Next.js)
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# WARNING: service_role key has full DB access — only use server-side, never expose
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
